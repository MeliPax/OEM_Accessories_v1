ready_to_upload/

# Secrets and credentials — keep locally, never commit
.env
*.env
creds/*
**/creds/*
# Placeholder-only templates are safe to commit
!**/creds/*_example.env

# Python bytecode (generated on every run)
__pycache__/
*.pyc

# Claude Code: per-person settings and locks (each person keeps their own)
.claude/settings.json
.claude/settings.local.json
.claude/scheduled_tasks.lock
