{
  "non_null_threshold": 0.5,
  "use_model_lookup": true,

  "column_definition": {
    "year_from": {
      "key_words": { "must_have": ["model", "year", "from"], "must_have_one_of": [], "not_have": [] }
    },
    "model": {
      "key_words": { "must_have": ["model"], "must_have_one_of": [], "not_have": ["year"] }
    },
    "part_number": {
      "key_words": { "must_have": ["part", "number"], "must_have_one_of": [], "not_have": [] }
    },
    "english_description": {
      "key_words": { "must_have": ["accessory", "description"], "must_have_one_of": [], "not_have": ["(fr)"] }
    },
    "french_description": {
      "key_words": { "must_have": ["accessory", "description", "(fr)"], "must_have_one_of": [], "not_have": [] }
    },
    "msrp": {
      "key_words": { "must_have": ["msrp"], "must_have_one_of": [], "not_have": [] }
    },
    "dnet": {
      "key_words": { "must_have": ["dnet"], "must_have_one_of": [], "not_have": [] }
    },
    "labour_rate": {
      "key_words": { "must_have": ["labour", "rate"], "must_have_one_of": [], "not_have": [] }
    },
    "labour_hours": {
      "key_words": { "must_have": ["labour", "hours"], "must_have_one_of": [], "not_have": [] }
    },
    "comments_en": {
      "key_words": { "must_have": ["comments"], "must_have_one_of": [], "not_have": ["(fr)"] }
    },
    "comments_fr": {
      "key_words": { "must_have": ["comments", "(fr)"], "must_have_one_of": [], "not_have": [] }
    }
  },

  "required_columns": [
    "part_number", "english_description", "msrp", "labour_hours"
  ],

  "non_null_columns": [
    "part_number", "english_description", "msrp", "labour_hours"
  ],

  "col_data_type_dict": {
    "to_string": ["part_number", "english_description", "french_description", "comments_en", "comments_fr"],
    "to_float": ["msrp", "dnet", "labour_rate", "labour_hours"]
  },

  "trim_bounds_config": {
    "left_bound": { "must_contain": [], "must_contain_one_of": [] },
    "right_bound": { "must_contain": [], "must_contain_one_of": [] }
  },

  "trim_validation_config": {
    "expected_data": { "data": "X", "perc_thresh": 60 },
    "must_have_only": { "expected_value_types": ["X", "", "__na__"] }
  },

  "non_acceptable_sheet_names": [],

  "sheet_name_pattern": ".*",

  "drop_columns": [],

  "trim_column_patterns": [
    "^trim[\\s_]\\d+$"
  ],

  "language_columns": {
    "EN": ["english_description", "comments_en"],
    "FR": ["french_description", "comments_fr"]
  },

  "rate_import_column_mapping": {
    "part_number":  "Part",
    "description":  "Description",
    "comments":     "Comments",
    "msrp":         "Price",
    "labour_hours": "Hours",
    "trim_level":   "Trim"
  },

  "rate_import_required_columns": ["Year", "Part", "Description", "Comments", "Price", "Hours", "Trim"],

  "output": {
    "ready_to_upload_path": "accy_v2/output/ready_to_upload/hyundai/",
    "dq_report_path":       "accy_v2/output/dq_reports/hyundai/",
    "pipeline_log_path":    "accy_v2/output/pipeline_logs/hyundai/"
  },

  "genesis_models": [
    "G70", "G80", "G80 EV", "G90", "GV60", "GV70", "GV70 EV", "GV80", "GV80 Coupe"
  ],

  "model_lookup_rules": {
    "Hyundai": {
      "valid_year_range": {
        "min": 1900,
        "max": 2100
      },
      "fuel_type_keywords": ["EV", "PHEV", "HEV", "FCEV"],
      "trim_abbreviation_library": {},
      "fields": ["trim", "model"],
      "trim_column": "trim_level",
      "exclude_keywords": ["ice", "combustion"],
      "ignore_keyword_categories": ["INTERIOR", "EXTERIOR_COLOR", "ENGINE_SPEC"],
      "use_single_char_token_matching": true
    },
    "Genesis": {
      "valid_year_range": {
        "min": 1900,
        "max": 2100
      },
      "fuel_type_keywords": ["EV", "PHEV", "HEV", "FCEV"],
      "trim_abbreviation_library": {},
      "fields": ["trim", "model"],
      "trim_column": "trim_level",
      "exclude_keywords": ["ice", "combustion"],
      "ignore_keyword_categories": ["INTERIOR", "EXTERIOR_COLOR", "ENGINE_SPEC"],
      "use_single_char_token_matching": true
    }
  }
}
