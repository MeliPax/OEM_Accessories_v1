{
  "non_null_threshold": 0.5,
  "use_model_lookup": true,

  "column_definition": {
    "part_number": {
      "key_words": { "must_have": ["part", "number"], "must_have_one_of": [], "not_have": [] }
    },
    "english_description": {
      "key_words": { "must_have": ["description"], "must_have_one_of": ["english","EN"], "not_have": [] }
    },
    "french_description": {
      "key_words": { "must_have": ["description"], "must_have_one_of": ["french", "FR"], "not_have": [] }
    },
    "msrp": {
      "key_words": { "must_have": ["msrp"], "must_have_one_of": [], "not_have": [] }
    },
    "dnp": {
      "key_words": { "must_have": ["dnp"], "must_have_one_of": [], "not_have": [] }
    },
    "install_time": {
      "key_words": { "must_have": ["install", "time"], "must_have_one_of": [], "not_have": [] }
    },
    "labour_rate": {
      "key_words": { "must_have": ["labour", "rate"], "must_have_one_of": [], "not_have": [] }
    },
    "remarks": {
      "key_words": { "must_have": ["remarks"], "must_have_one_of": [], "not_have": [] }
    }
  },

  "required_columns": [
    "part_number", "english_description", "french_description",
    "msrp", "dnp", "install_time", "labour_rate"
  ],

  "non_null_columns": [
    "part_number", "english_description", "msrp", "install_time"
  ],

  "col_data_type_dict": {
    "to_string": ["part_number", "english_description", "french_description"],
    "to_float":  ["msrp", "dnp", "install_time", "labour_rate"]
  },

  "trim_bounds_config": {
    "left_bound":  { "must_contain": ["remarks"], "must_contain_one_of": [] },
    "right_bound": { "must_contain": [], "must_contain_one_of": ["photo", "image"] }
  },

  "trim_validation_config": {
    "expected_data":  { "data": "X", "perc_thresh": 60 },
    "must_have_only": { "expected_value_types": ["X", "", "__na__"] }
  },

  "non_acceptable_sheet_names": ["meta_data", "luxwood"],

  "sheet_name_pattern": "^\\d{4}\\s+.+",

  "drop_columns": ["photo", "image", "installed_price", "imc", "install_sheet", "category"],

  "language_columns": {
    "EN": ["english_description"],
    "FR": ["french_description"]
  },

  "rate_import_column_mapping": {
    "part_number":  "Part",
    "description":  "Description",
    "remarks":      "Comments",
    "msrp":         "Price",
    "install_time": "Hours",
    "trim_level":   "Trim"
  },

  "rate_import_required_columns": ["Part", "Description", "Comments", "Price", "Hours", "Trim"],

  "output": {
    "ready_to_upload_path": "accy_v2/output/ready_to_upload/mitsubishi/",
    "dq_report_path":       "accy_v2/output/dq_reports/mitsubishi/",
    "pipeline_log_path":    "accy_v2/output/pipeline_logs/mitsubishi/"
  },

  "model_lookup_rules": {
    "Mitsubishi": {
      "sheet_name_format": "YYYY_ModelName_Language",
      "valid_year_range": {
        "min": 1900,
        "max": 2100
      },
      "fuel_type_keywords": ["EV", "PHEV", "HEV", "FCEV"],
      "trim_abbreviation_library": {
        "p": "premium",
        "n": "noir",
        "prem": "premium"
      },
      "fields": ["trim", "model", "fuel_type"],
      "trim_column": "trim_level",
      "exclude_keywords": []
    }
  }
}
